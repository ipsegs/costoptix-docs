{
  "$schema": "https://mintlify.com/schema.json",
  "name": "CostOptix",
  "logo": {
    "dark": "/favicon.png",
    "light": "/favicon.png"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5",
    "anchors": {
      "from": "#6366f1",
      "to": "#4f46e5"
    }
  },
  "topbarLinks": [
    {
      "name": "Sign In",
      "url": "https://costoptix.com/login"
    }
  ],
  "topbarCtaButton": {
    "name": "Get Started Free",
    "url": "https://costoptix.com/signup"
  },
  "anchors": [
    {
      "name": "Status",
      "icon": "circle-check",
      "url": "https://costoptix.com/status"
    },
    {
      "name": "Support",
      "icon": "envelope",
      "url": "https://costoptix.com/contact"
    }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": [
        "introduction",
        "quickstart",
        "getting-started/subscription-tiers",
        "how-costoptix-compares"
      ]
    },
    {
      "group": "Connect Your Sources",
      "pages": [
        "providers/overview",
        "providers/azure",
        "providers/aws",
        "providers/gcp",
        "providers/kubernetes",
        "providers/hosts",
        "providers/llm"
      ]
    },
    {
      "group": "See Your Spend",
      "pages": [
        "features/overview",
        "features/cost-dashboard",
        "features/daily-spend",
        "features/cost-explorer",
        "features/service-explorer",
        "features/tag-explorer"
      ]
    },
    {
      "group": "Act On It",
      "pages": [
        "features/anomaly-detection",
        "features/budgets",
        "features/recommendations",
        "features/ownership",
        "features/unit-economics"
      ]
    },
    {
      "group": "Tools and Alerts",
      "pages": [
        "features/ai-insights",
        "features/webhooks",
        "features/provider-news"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api-reference/authentication"
      ]
    },
    {
      "group": "Account",
      "pages": [
        "account/team-management",
        "account/sso",
        "account/audit-log"
      ]
    },
    {
      "group": "Security",
      "pages": [
        "security"
      ]
    }
  ],
  "footerSocials": {
    "x": "https://x.com/costoptix",
    "linkedin": "https://linkedin.com/company/costoptix"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": {
    "prompt": "Search CostOptix docs..."
  },
  "redirects": [
    {
      "source": "/features/multi-account",
      "destination": "/features/overview"
    },
    {
      "source": "/features/quarterly-report",
      "destination": "/features/overview"
    },
    {
      "source": "/account/security",
      "destination": "/security"
    },
    {
      "source": "/providers/heroku",
      "destination": "/providers/overview"
    }
  ]
}
